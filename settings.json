{
  "workbench.colorTheme": "NetBeans Light Theme",
  "java.jdt.ls.java.home": "..\\jdk",
  "maven.executable.path": "${env:MAVEN_HOME}\\bin\\mvn",
  "editor.tabSize": 1,
  "[jsonc]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "[javascript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "[html]": {
    "editor.defaultFormatter": "vscode.html-language-features",
  },
  "security.workspace.trust.untrustedFiles": "open",
  "[json]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "[dart]": {
    "editor.hover.enabled": "off",
  },
  "rsp-ui.enableStartServerOnActivation": [
    {
      "id": "redhat.vscode-community-server-connector",
      "name": "Community Server Connector",
      "startOnActivation": true,
    },
    {
      "id": "redhat.vscode-server-connector",
      "name": "Red Hat Server Connector",
      "startOnActivation": true,
    },
  ],
  "redhat.telemetry.enabled": true,
  "nativescript.analytics.enabled": false,
  "workbench.startupEditor": "none",
  "[typescript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "workbench.iconTheme": "vscode-icons",
  // Amplie a fonte do editor ao usar a roda do mouse e segurar `Ctrl`.
  "editor.mouseWheelZoom": true,
  // habilita atualização automática de imports ao mover ou renomear um arquivo
  "javascript.updateImportsOnFileMove.enabled": "always",
  // forma de exibição das pastas
  "explorer.compactFolders": false,
  //desabilita o autosalvamento
  "files.autoSave": "off",
  "task.saveBeforeRun": "always",
  "debug.saveBeforeStart": "allEditorsInActiveGroup",
  "code-runner.saveFileBeforeRun": true,
  // auto salvamento de arquivos ao passar um tempo
  //"files.autoSave": "afterDelay",
  //"files.autoSaveDelay": 1000,
  // fim de linha
  "files.eol": "\n",
  //arquivos e pastas não exibidos
  "files.exclude": {
    "**/.git": true,
    "**/.DS_Store": true,
    "**/package-lock.json": true,
    "**/.classpath": true,
    "**/.project": true,
    "**/.settings": true,
    "**/.factorypath": true,
    "**/.mvn": true,
    "**/.idea": true,
    "**/test": true,
    "**/target": true,
    "**/.vscode": false,
    "**/node-modules": false,
    "**/dist": false,
    //"**/*.vue": true,
    "**/*.class": true,
  },
  //esconde as dicas em caixa que são exibidas
  "editor.parameterHints.enabled": false,
  "editor.suggest.snippetsPreventQuickSuggestions": false,
  "html.suggest.html5": false,
  "editor.hover.enabled": "on",
  //esconde os nomes de parâmetros inline
  "editor.inlayHints.enabled": "off",
  "gitlens.defaultDateLocale": null,
  "[vue]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "vetur.format.options.tabSize": 1,
  "[scss]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "terminal.integrated.fontSize": 14,
  "terminal.integrated.profiles.windows": {
    "PowerShell": {
      "source": "PowerShell",
      "icon": "terminal-powershell",
      "args": ["-ExecutionPolicy", "Bypass"],
      //"args": ["-ExecutionPolicy", "Restricted"]
    },
    "Command Prompt": {
      "path": [
        "${env:windir}\\Sysnative\\cmd.exe",
        "${env:windir}\\System32\\cmd.exe",
      ],
      "args": [],
      "icon": "terminal-cmd",
    },
    "Git Bash": {
      "source": "Git Bash",
    },
  },
  "terminal.integrated.defaultProfile.windows": "Command Prompt",
  "emulator.emulatorPath": "%ANDROID_HOME%\\emulator",
  "files.associations": {
    "*.html": "html",
  },
  "liveServer.settings.donotVerifyTags": true,
  "editor.minimap.enabled": false,
  "[css]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "liveServer.settings.CustomBrowser": "microsoft-edge",
  "maui.configuration.javaSdkPreferredPath": "${env:JAVA_HOME}",
  "maui.configuration.androidSdkPreferredPath": "..\\android\\sdk",
  "emmet.includeLanguages": {
    "jsp": "html",
  },
  "github.copilot.enable": {
    "*": true,
    "plaintext": false,
    "markdown": false,
    "scminput": false,
  },
  "java.completion.favoriteStaticMembers": [
    "org.junit.Assert.*",
    "org.junit.Assume.*",
    "org.junit.jupiter.api.Assertions.*",
    "org.junit.jupiter.api.Assumptions.*",
    "org.junit.jupiter.api.DynamicContainer.*",
    "org.junit.jupiter.api.DynamicTest.*",
    "org.mockito.Mockito.*",
    "org.mockito.ArgumentMatchers.*",
    "org.mockito.Answers.*",
    "com.microsoft.playwright.assertions.PlaywrightAssertions.*",
  ],
  "dart.devToolsLocation": {
    "performance": "active",
    "default": "beside",
    "inspector": "sidebar",
  },
  "mdb.confirmRunAll": false,
  "chat.viewSessions.orientation": "stacked",
  "sonarlint.automaticAnalysis": true,
  "gitlens.ai.model": "vscode",
  "gitlens.ai.vscode.model": "copilotcli:claude-sonnet-4.6",
  "markdown-pdf.headerTemplate": "<div style=\"font-size: 9px; margin-left: auto; margin-right: 1cm; \">%%ISO-DATE%%</div>",
  "markdown-pdf.includeDefaultStyles": true,
  "markdown-pdf.printBackground": true,
  "markdown-pdf.math.enabled": true,
  "markdown-pdf.sanitize": "gfm-allow-style",
  "markdown.marp.html": "all",
  "markdown.marp.pptx.editable": "off",
  "markdown.marp.strictPathResolutionDuringExport": false,
  "markdown-pdf.outputDirectory": "../share",
  "markdown-pdf.outputDirectoryRelativePathFile": true,
  "markdownStudio.export.pdfToc.hidden": true,
  "markdownStudio.export.pdfIndex.title": "Conteúdo do documento",
  "markdownStudio.codeBlock.lineNumbers": false,
  "markdownStudio.export.footer.template": "<div style=\"font-size: 9px; margin-left: auto; margin-right: 1cm; \">Página <span class='pageNumber'></span> de <span class='totalPages'></span></div>",
  "markdownStudio.export.pdfBookmarks.enabled": true,
  "explorer.fileNesting.patterns": {
    "*.ts": "${capture}.js",
    "*.js": "${capture}.js.map, ${capture}.min.js, ${capture}.d.ts",
    "*.jsx": "${capture}.js",
    "*.tsx": "${capture}.ts",
    "tsconfig.json": "tsconfig.*.json",
    "package.json": "package-lock.json, yarn.lock, pnpm-lock.yaml, bun.lockb, bun.lock",
    "pubspec.yaml": "pubspec.lock,pubspec_overrides.yaml,.packages,.flutter-plugins,.flutter-plugins-dependencies,.metadata",
    "*.dart": "${capture}.g.dart",
    "*.cs": "${capture}.designer.cs,${capture}.g.cs,${capture}.generated.cs,${capture}.run.json,${capture}.settings.json,${capture}.settings.*.json",
    "*.csproj": "${capture}.csproj.user",
    "*.json": "${capture}.Development.json",
    "*.cshtml": "${capture}.cshtml.cs,${capture}.cshtml.css",
    "*.razor": "${capture}.razor.cs,${capture}.razor.css",
    "*.resx": "${capture}.Designer.cs",
    "*.xaml": "${capture}.xaml.cs",
    "*.sqlite": "${capture}.${extname}-*",
    "*.db": "${capture}.${extname}-*",
    "*.sqlite3": "${capture}.${extname}-*",
    "*.db3": "${capture}.${extname}-*",
    "*.sdb": "${capture}.${extname}-*",
    "*.s3db": "${capture}.${extname}-*"
  },
}
